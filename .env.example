# Without OPENAI_API_KEY, relationship analysis replays labeled demo fixtures.
# Reserved server-only configuration. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Set a Responses API model supporting strict structured outputs for live analysis.
OPENAI_MODEL=
# Optional server-only private app token with crm.objects.contacts.read/write scopes.
# Blank enables preview + explicitly labeled simulation. Restart after changing.
HUBSPOT_ACCESS_TOKEN=


